{
  "name": "wexample/symfony-template",
  "description": "Various helpers for Symfony templating",
  "type": "library",
  "license": "MIT",
  "version": "2.1.2",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyTemplate\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyTemplate\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "ext-dom": "*",
    "league/commonmark": "^2.4",
    "symfony/yaml": ">=6.2",
    "wexample/symfony-helpers": ">=18.0.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}